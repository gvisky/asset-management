# ── Hayat Communication Tools — server settings ─────────────────────────────
# Copy to .env (cp .env.example .env) and fill in. Never commit .env.
# Copy the values from Render → asset-management → Environment.

# Database. Step 1: keep using Turso (same live data as Render, nothing to copy).
# Step 6 (optional): move the data onto this server — then empty these two lines.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin password for the first-run account (same as on Render)
ADMIN_PASS=
# App owner (default: viet) — this login can never be deleted and only the owner can change it.
# If it is ever missing it is recreated on start with ADMIN_PASS.
#APP_OWNER=viet

# Feature switches — copy from Render (leave empty if Render doesn't have them)
IMPORTS_ENABLED=
UNDO_IMPORT_ENABLED=

NODE_ENV=production

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Option A (own tunnel): paste the tunnel token and keep COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
COMPOSE_PROFILES=tunnel
# Option B (reuse the ETL tunnel): empty COMPOSE_PROFILES and set these two
#COMPOSE_FILE=docker-compose.yml:docker-compose.shared-tunnel.yml
#SHARED_TUNNEL_NETWORK=smartetl_default

# Where the database file is kept (step 6). Default: deploy/data next to this file — same drive as the project.
#DATA_DIR=./data

# Port on the server itself for testing (http://127.0.0.1:3010). Change if 3010 is taken.
LOCAL_PORT=3010

# Backups (backup.sh): days to keep, and optional rclone remote for an off-site copy
BACKUP_KEEP_DAYS=30
#BACKUP_RCLONE_REMOTE=b2:hayat-backups/asset-management
